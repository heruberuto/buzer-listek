{
  "name": "heruberuto/buzerlistek",
  "description": "Webová aplikace pro tvorbu a vyplňování buzer-lístku",
  "keywords": [
    "osobní motivace",
    "buzer-lístek",
    "prokrastinace"
  ],
  "homepage": "https://wa.toad.cz/~ullriher/",
  "type": "project",
  "license": "BSD-3-Clause",
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.2",
    "yiisoft/yii2": "~2.0.53",
    "fortawesome/font-awesome": "~4.7.0",
    "npm-asset/bootstrap": "^4.6.2",
    "yiisoft/yii2-bootstrap4": "~2.0.11",
    "yiisoft/yii2-symfonymailer": "~4.0",
    "yiisoft/yii2-authclient": "~2.2",
    "kartik-v/yii2-date-range": "~1.7",
    "himiklab/yii2-sortable-grid-view-widget": "~1.0.11"
  },
  "require-dev": {
    "yiisoft/yii2-debug": "~2.1",
    "yiisoft/yii2-gii": "~2.2",
    "yiisoft/yii2-faker": "~2.0",
    "codeception/codeception": "^5.1",
    "codeception/module-asserts": "^3.0",
    "codeception/module-filesystem": "^3.0",
    "codeception/module-yii2": "^1.1",
    "codeception/verify": "^3.0",
    "codeception/specify": "^2.0"
  },
  "config": {
    "process-timeout": 1800,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "scripts": {
    "post-create-project-cmd": [
      "yii\\composer\\Installer::postCreateProject"
    ]
  },
  "extra": {
    "yii\\composer\\Installer::postCreateProject": {
      "setPermission": [
        {
          "runtime": "0777",
          "web/assets": "0777",
          "yii": "0755"
        }
      ],
      "generateCookieValidationKey": [
        "config/web.php"
      ]
    }
  },
  "prefer-stable": true,
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ]
}
